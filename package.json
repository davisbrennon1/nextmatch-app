{
  "name": "nextmatch",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "firebase deploy --only hosting,firestore,functions",
    "test": "npm run test:rules && npm run test:functions",
    "test:rules": "firebase emulators:exec --only firestore --project demo-nextmatch \"node tests/rules.test.mjs\"",
    "test:functions": "firebase emulators:exec --only functions,firestore --project demo-nextmatch \"node tests/functions.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "firebase": "10.12.2",
    "firebase-tools": "13.29.1"
  }
}