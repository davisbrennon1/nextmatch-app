rules_version = '2';

// Who can read and change what in the NextMatch database.
// Everything requires a signed-in account. People can only change their own
// stuff. Ranking points, records, final results, reminders and notifications are
// written only by the server code in functions/ (or by you in the Firebase console).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isMe(uid) { return signedIn() && me() == uid; }
    function str(v, lo, hi) { return v is string && v.size() >= lo && v.size() <= hi; }
    function data() { return request.resource.data; }
    function changedOnly(keys) { return data().diff(resource.data).affectedKeys().hasOnly(keys); }
    function added(field) { return data().get(field, []).toSet().difference(resource.data.get(field, []).toSet()); }
    function removed(field) { return resource.data.get(field, []).toSet().difference(data().get(field, []).toSet()); }
    function same(field) { return added(field).size() == 0 && removed(field).size() == 0; }
    // The list changed by exactly one entry: the signed-in person's own id.
    function toggledSelf(field) { return added(field).union(removed(field)) == [me()].toSet(); }
    function teamDoc(tid) { return get(/databases/$(database)/documents/teams/$(tid)).data; }
    function inTeam(tid) { return tid == null || me() in teamDoc(tid).members; }
    function blockedBy(uid) { return exists(/databases/$(database)/documents/users/$(uid)/blocked/$(me())); }
    function sports() { return ['Basketball', 'Flag football', 'Football']; }
    function formats() { return ['1v1', '2v2', '3v3', '4v4', '5v5', '6v6', '7v7', '8v8', '9v9', '11v11']; }
    function leagueDoc(lid) { return get(/databases/$(database)/documents/leagues/$(lid)).data; }
    function ageGroups() { return ['6U', '8U', '10U', '12U', '14U', 'High school']; }

    // ───────── Players ─────────
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid)
        && data().keys().hasOnly(['name', 'city', 'sports', 'rp', 'wins', 'losses', 'adult', 'createdAt'])
        && str(data().name, 2, 40)
        && str(data().city, 2, 40)
        && data().sports is list && data().sports.size() <= 2
        && data().rp == 0 && data().wins == 0 && data().losses == 0
        && data().adult == true;
      allow update: if isMe(uid)
        && changedOnly(['name', 'city', 'sports', 'tournamentInterest'])
        && str(data().name, 2, 40)
        && str(data().city, 2, 40)
        && data().sports is list && data().sports.size() <= 2
        && data().get('tournamentInterest', []).size() <= 10;

      match /following/{other} {
        allow read: if signedIn();
        allow create: if isMe(uid) && other != uid;
        allow delete: if isMe(uid);
      }
      match /blocked/{other} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(uid) && other != uid && data().keys().hasOnly(['at']);
      }
      // Weekly fitness challenges: one claim per challenge per week, never edited.
      match /workouts/{wid} {
        allow read: if isMe(uid);
        allow create: if isMe(uid)
          && data().keys().hasOnly(['challenge', 'week', 'fp', 'at'])
          && data().challenge in ['footwork', 'handles', 'mobility']
          && data().fp == {'footwork': 50, 'handles': 75, 'mobility': 40}[data().challenge]
          && str(data().week, 10, 10)
          && wid == data().week + '_' + data().challenge;
      }
      // Written by the server; people can read, mark read and clear their own.
      match /notifications/{nid} {
        allow read, delete: if isMe(uid);
        allow update: if isMe(uid) && changedOnly(['read']) && data().read == true;
      }
      // Devices that receive push notifications.
      match /tokens/{token} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(uid) && data().keys().hasOnly(['at', 'ua']);
      }
    }

    // ───────── Teams ─────────
    match /teams/{tid} {
      function captain() { return resource.data.captainUid == me(); }
      allow read: if signedIn();
      allow create: if signedIn()
        && data().keys().hasOnly(['name', 'sport', 'city', 'captainUid', 'members', 'rp', 'wins', 'losses', 'createdAt', 'youth', 'ageGroup'])
        && data().captainUid == me() && data().members == [me()]
        && str(data().name, 2, 40) && str(data().city, 2, 40) && data().sport in sports()
        // Youth teams are run by adult coaches; tackle football is youth-only.
        && (data().get('youth', false) == false || (data().youth == true && data().ageGroup in ageGroups()))
        && (data().sport != 'Football' || data().get('youth', false) == true)
        && data().rp == 0 && data().wins == 0 && data().losses == 0;
      allow update: if signedIn() && (
        // Captain: rename, add someone who asked to join, or remove one member.
        (captain()
          && changedOnly(['name', 'members', 'lastChange'])
          && str(data().name, 2, 40)
          && me() in data().members
          && data().members.size() <= 15
          && (same('members')
            || (added('members') == [data().lastChange].toSet() && removed('members').size() == 0
                && exists(/databases/$(database)/documents/teams/$(tid)/requests/$(data().lastChange)))
            || (removed('members') == [data().lastChange].toSet() && added('members').size() == 0)))
        // Anyone else: leave the team.
        || (!captain() && changedOnly(['members']) && removed('members') == [me()].toSet() && added('members').size() == 0)
      );
      allow delete: if signedIn() && captain() && resource.data.members.size() == 1;

      match /requests/{uid} {
        allow read: if isMe(uid) || teamDoc(tid).captainUid == me();
        allow create: if isMe(uid) && !(uid in teamDoc(tid).members) && data().keys().hasOnly(['name', 'at']) && str(data().name, 1, 40);
        allow delete: if isMe(uid) || teamDoc(tid).captainUid == me();
      }
      match /messages/{mid} {
        allow read: if signedIn() && me() in teamDoc(tid).members;
        allow create: if signedIn() && me() in teamDoc(tid).members
          && data().keys().hasOnly(['uid', 'name', 'text', 'at'])
          && data().uid == me() && str(data().name, 1, 40) && str(data().text, 1, 1000);
      }
      // Kid players on youth teams: added by a parent, approved by a coach.
      // Only the team's coaches and the kid's own parent can see them.
      match /kids/{kidId} {
        allow read: if signedIn() && (me() in teamDoc(tid).members || resource.data.parentUid == me());
        allow create: if signedIn() && teamDoc(tid).get('youth', false) == true
          && data().keys().hasOnly(['name', 'jersey', 'parentUid', 'parentName', 'status', 'at'])
          && data().parentUid == me() && data().status == 'pending'
          && str(data().name, 2, 30) && str(data().jersey, 0, 3) && str(data().parentName, 1, 40);
        allow update: if signedIn() && me() in teamDoc(tid).members
          && changedOnly(['status', 'jersey']) && data().status in ['approved', 'pending'] && str(data().jersey, 0, 3);
        allow delete: if signedIn() && (resource.data.parentUid == me() || me() in teamDoc(tid).members);
      }
    }

    // A parent's own kids across all youth teams ("My kids").
    match /{path=**}/kids/{kidId} {
      allow read: if signedIn() && resource.data.parentUid == me();
    }

    // ───────── Seasons and tournaments ─────────
    // Anyone can organize one. Team captains ask to enter; the organizer approves.
    // Standings and season stats are written only by the server.
    match /leagues/{lid} {
      function organizer() { return resource.data.organizerUid == me(); }
      allow read: if signedIn();
      allow create: if signedIn()
        && data().keys().hasOnly(['type', 'division', 'sport', 'format', 'ageGroup', 'name', 'description', 'city', 'start', 'end', 'organizerUid', 'organizerName', 'teamIds', 'teamNames', 'staff', 'createdAt'])
        && data().type in ['season', 'tournament'] && data().division in ['adult', 'youth']
        && data().sport in sports() && data().format in formats()
        && (data().sport != 'Football' || data().division == 'youth')
        && (data().division == 'adult' || data().ageGroup in ageGroups())
        && str(data().name, 3, 60) && str(data().description, 0, 500) && str(data().city, 2, 40)
        && data().start is timestamp && data().end is timestamp && data().end > data().start
        && data().organizerUid == me() && str(data().organizerName, 1, 40)
        && data().teamIds == [] && data().teamNames == {} && data().staff == [me()];
      allow update: if signedIn() && organizer()
        && changedOnly(['name', 'description', 'start', 'end', 'teamIds', 'teamNames', 'staff', 'lastChange'])
        && str(data().name, 3, 60) && str(data().description, 0, 500) && data().end > data().start
        && data().teamIds.size() <= 64 && me() in data().staff
        && ((same('teamIds') && same('staff'))
          // add a team that asked to enter, and its captain as staff
          || (added('teamIds') == [data().lastChange].toSet() && removed('teamIds').size() == 0
              && exists(/databases/$(database)/documents/leagues/$(lid)/entries/$(data().lastChange))
              && added('staff').difference([teamDoc(data().lastChange).captainUid].toSet()).size() == 0)
          || (removed('teamIds') == [data().lastChange].toSet() && added('teamIds').size() == 0 && added('staff').size() == 0));
      allow delete: if signedIn() && organizer() && resource.data.teamIds.size() == 0;

      match /entries/{teamId} {
        allow read: if signedIn() && (leagueDoc(lid).organizerUid == me() || teamDoc(teamId).captainUid == me());
        allow create: if signedIn() && teamDoc(teamId).captainUid == me()
          && data().keys().hasOnly(['teamName', 'captainUid', 'captainName', 'at'])
          && data().captainUid == me() && str(data().teamName, 1, 40) && str(data().captainName, 1, 40)
          && teamDoc(teamId).sport == leagueDoc(lid).sport
          && teamDoc(teamId).get('youth', false) == (leagueDoc(lid).division == 'youth');
        allow delete: if signedIn() && (leagueDoc(lid).organizerUid == me() || teamDoc(teamId).captainUid == me());
      }
      match /standings/{teamId} {
        allow read: if signedIn();
      }
      // Kids' season stats are only shown to the season's organizer and coaches, and the kid's parent.
      match /stats/{key} {
        allow get: if signedIn() && (resource.data.get('youth', false) == false || me() in leagueDoc(lid).staff || resource.data.get('parentUid', '') == me());
        // Lists: anyone for adult seasons; for youth seasons only staff, or a parent asking for their own kids.
        allow list: if signedIn() && (leagueDoc(lid).division == 'adult' || me() in leagueDoc(lid).staff || resource.data.parentUid == me());
      }
    }

    // ───────── Games and results ─────────
    match /games/{gid} {
      function size() { return int(resource.data.format.split('v')[0]); }
      function inGame(side) { return me() in resource.data[side]; }
      function otherSide(side) { return side == 'home' ? 'away' : 'home'; }

      allow read: if signedIn();
      allow create: if signedIn()
        && data().keys().hasOnly(['hostUid', 'hostName', 'sport', 'format', 'need', 'venue', 'venueLat', 'venueLng', 'city', 'when', 'home', 'away', 'players', 'status', 'homeTeamId', 'homeTeamName', 'awayTeamId', 'awayTeamName', 'leagueId', 'leagueName', 'createdAt'])
        // Season or tournament games: both teams must be in it, playing its sport.
        && (data().get('leagueId', null) == null || (str(data().leagueName, 1, 60)
            && data().homeTeamId in leagueDoc(data().leagueId).teamIds && data().awayTeamId in leagueDoc(data().leagueId).teamIds
            && data().homeTeamId != data().awayTeamId && data().sport == leagueDoc(data().leagueId).sport))
        && (data().sport != 'Football' || data().get('leagueId', null) != null)
        // Map location of the place, when it was picked from the list of courts and fields.
        && (!('venueLat' in data()) || (data().venueLat is number && data().venueLat >= -90 && data().venueLat <= 90
            && data().venueLng is number && data().venueLng >= -180 && data().venueLng <= 180))
        && data().hostUid == me()
        && data().home == [me()] && data().away == [] && data().players == [me()]
        && data().status == 'open'
        && data().sport in sports()
        && data().format in formats()
        && str(data().hostName, 1, 40) && str(data().need, 1, 40)
        && str(data().venue, 2, 100) && str(data().city, 2, 40)
        && data().when is timestamp
        && inTeam(data().get('homeTeamId', null))
        && (data().get('awayTeamId', null) == null || exists(/databases/$(database)/documents/teams/$(data().awayTeamId)));

      allow update: if signedIn() && (
        // Join one side (if that side is a team, only its members), or leave.
        (resource.data.status == 'open'
          && changedOnly(['home', 'away', 'players'])
          && toggledSelf('players')
          && data().home.size() <= size() && data().away.size() <= size()
          && ((added('home') == [me()].toSet() && same('away') && inTeam(resource.data.get('homeTeamId', null)))
            || (added('away') == [me()].toSet() && same('home') && inTeam(resource.data.get('awayTeamId', null)))
            || (me() != resource.data.hostUid
                && ((removed('home') == [me()].toSet() && same('away'))
                  || (removed('away') == [me()].toSet() && same('home'))))))
        // After start time, a player reports the final score for both sides to see.
        || (resource.data.status in ['open', 'disputed']
          && changedOnly(['status', 'report', 'responseBy'])
          && data().status == 'reported'
          && resource.data.when <= request.time
          && resource.data.home.size() > 0 && resource.data.away.size() > 0
          && data().report.keys().hasOnly(['by', 'side', 'home', 'away', 'at', 'players', 'kids'])
          // Youth games: coaches enter each kid's points (checked against the rosters by the server).
          && (!('kids' in data().report) || (data().report.kids is map && data().report.kids.size() <= 80))
          // Optional points per player: only people in this game, at most 14 entries.
          && (!('players' in data().report) || (data().report.players is map
              && data().report.players.size() <= 14
              && data().report.players.keys().toSet().difference(resource.data.home.toSet().union(resource.data.away.toSet())).size() == 0))
          && data().report.by == me()
          && data().report.side in ['home', 'away'] && inGame(data().report.side)
          && data().report.home is int && data().report.home >= 0 && data().report.home <= 999
          && data().report.away is int && data().report.away >= 0 && data().report.away <= 999
          && data().report.at == request.time)
        // Someone on the OTHER side confirms or disputes it.
        || (resource.data.status == 'reported'
          && changedOnly(['status', 'responseBy', 'confirmKids'])
          // Youth games: the confirming coach adds their own kids' points.
          && (!('confirmKids' in data()) || (data().confirmKids is map && data().confirmKids.size() <= 80 && data().status == 'confirmed'))
          && data().status in ['confirmed', 'disputed']
          && data().responseBy == me()
          && inGame(otherSide(resource.data.report.side)))
      );
      allow delete: if signedIn() && resource.data.hostUid == me() && resource.data.status == 'open';
    }

    // ───────── Feed ─────────
    match /posts/{pid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && data().keys().hasOnly(['uid', 'name', 'city', 'kind', 'caption', 'sport', 'art', 'mediaUrl', 'mediaType', 'likedBy', 'createdAt'])
        && data().uid == me()
        && data().kind in ['Highlight', 'Training']
        && str(data().name, 1, 40)
        && str(data().caption, 1, 1000)
        && data().likedBy == [];
      // Likes: anyone can add or remove only their own like.
      allow update: if signedIn() && changedOnly(['likedBy']) && toggledSelf('likedBy');
      allow delete: if signedIn() && resource.data.uid == me();

      match /comments/{cid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && data().keys().hasOnly(['uid', 'name', 'text', 'at'])
          && data().uid == me()
          && str(data().name, 1, 40)
          && str(data().text, 1, 500)
          && !blockedBy(get(/databases/$(database)/documents/posts/$(pid)).data.uid);
        allow delete: if signedIn() && resource.data.uid == me();
      }
    }

    // ───────── Direct messages ─────────
    // The conversation id is the two members' ids joined by "_".
    match /conversations/{cid} {
      function members() { return cid.split('_'); }
      function other() { return members()[0] == me() ? members()[1] : members()[0]; }
      function inConvo() { return signedIn() && members().size() == 2 && members()[0] != members()[1] && me() in members(); }

      allow read: if signedIn() && me() in resource.data.members;
      allow create, update: if inConvo() && !blockedBy(other())
        && data().members == members()
        && data().lastUid == me()
        && str(data().last, 1, 120);

      match /messages/{mid} {
        allow read: if inConvo();
        allow create: if inConvo() && !blockedBy(other())
          && data().keys().hasOnly(['uid', 'text', 'at'])
          && data().uid == me()
          && str(data().text, 1, 1000);
      }
    }

    // ───────── Courts, fields and parks near each city (written by the server) ─────────
    match /venues/{city} {
      allow read: if signedIn();
    }

    // ───────── Safety reports ─────────
    // Anyone can file one. Only you (in the Firebase console) can read them.
    match /reports/{rid} {
      allow create: if signedIn()
        && data().keys().hasOnly(['by', 'targetType', 'targetId', 'targetUid', 'reason', 'details', 'at'])
        && data().by == me()
        && data().targetType in ['user', 'post', 'game', 'team', 'message']
        && str(data().targetId, 1, 200)
        && str(data().targetUid, 0, 128)
        && data().reason in ['Harassment or hate', 'Spam or scam', 'Inappropriate content', 'Cheating or fake results', 'Unsafe at a game', 'Other']
        && str(data().details, 0, 500)
        && data().at == request.time;
    }
  }
}
